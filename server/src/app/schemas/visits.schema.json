{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hospital Visits Export",
  "type": "object",
  "required": ["visits"],
  "properties": {
    "visits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["visit_id", "date", "doctor", "patient"],
        "properties": {
          "visit_id": { "type": "integer" },
          "date": { "type": "string", "format": "date" },
          "doctor": {
            "type": "object",
            "required": ["name", "license"],
            "properties": {
              "name": { "type": "string" },
              "license": { "type": "string" }
            }
          },
          "patient": {
            "type": "object",
            "required": ["dni", "first_name", "last_name"],
            "properties": {
              "dni": { "type": "string" },
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "health_card": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
