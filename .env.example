# Environment template for Hospital Management System deployments
# Copy this file to /etc/hms.env or /opt/hms/.env (owned by root) and fill secure values.

# Database settings
DB_NAME=hospital_management
DB_HOST=localhost
DB_PORT=5432
DB_USER=backup_user
# DB_PASSWORD should be stored securely; do NOT commit real passwords
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Backup settings
BACKUP_DIR=/backups/local
RETENTION=5

# AWS S3 (optional) - bucket name only
AWS_BUCKET=hms-backups

# Application settings
HMS_API_USER=hms
HMS_API_DIR=/opt/hms
